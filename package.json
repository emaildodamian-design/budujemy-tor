{
  "name": "budujemy-tor",
  "private": true,
  "version": "0.1.0",
  "description": "Co-play turn-based train track PWA for a parent and a young child (offline, no tracking).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "levels": "UPDATE_LEVELS=1 vitest run tests/levels.test.ts",
    "gen": "node scripts/run-ts.mjs scripts/gen-levels.ts",
    "gen:set": "node scripts/run-ts.mjs scripts/build-set.ts",
    "gen4": "node scripts/run-ts.mjs scripts/gen4.ts",
    "levels4": "UPDATE_LEVELS=1 vitest run tests/levels4.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
